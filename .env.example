NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Use 127.0.0.1 for local dev — Spotify rejects http://localhost redirect URIs
NEXT_PUBLIC_REDIRECT_URI=http://127.0.0.1:3000/
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Used by `yarn get-refresh-token` only — add this in Spotify dashboard
# SPOTIFY_TOKEN_REDIRECT_URI=http://127.0.0.1:8888/callback